# Real log-in texts (see docs/onboarding.md › Real text messages).
# Copy this file to .env.local and fill in both values from your Supabase
# project (Project Settings › API). Without them the app stays in demo mode:
# no text is sent and any 6 digits log in.
# The publishable key is meant to ship inside apps; never put a secret or
# service-role key here.
# The URL is just the project's address, like https://abcdefghijklmnop.supabase.co,
# with nothing after it: not the .../rest/v1/ address the API pages also show.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
